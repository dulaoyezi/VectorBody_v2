FROM python:3.10-slim-bookworm
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 VECTORBODY_DATA_DIR=/app/reports/web
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements_web_v2.txt ./
RUN pip install --no-cache-dir -r requirements_web_v2.txt
COPY core ./core
COPY web_v2 ./web_v2
RUN mkdir -p /app/reports/web
EXPOSE 8000
CMD ["python","-m","uvicorn","web_v2.app:app","--host","0.0.0.0","--port","8000","--proxy-headers"]